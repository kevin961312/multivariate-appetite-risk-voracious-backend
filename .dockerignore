# Contexto de build de Docker: solo lo que necesitan las etapas builder, gate y runtime.
# Los fixtures versionados (packages/pymrcd/tests/golden/fixtures, tests/) se quedan: los usa `gate`.

# Control de versiones y entornos locales
.git
.githooks
.venv
venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
build
dist
**/*.so
**/*.pyd

# Cachés y salidas de herramientas
.gates
.gate.log
.ruff_cache
.mypy_cache
.pytest_cache
.import_linter_cache
.coverage
.coverage.*
coverage.xml
htmlcov

# Secretos y configuración local (la plantilla sí entra)
.env
.env.*
!.env.example
.claude/settings.local.json

# Material local que no se versiona
referencias
datos
plantilla-agentes
.DS_Store
.idea
.vscode
.Rhistory
.RData
.Rproj.user
tools/r/experimentos/resultados/mc_canonico2

# Docker y CI no hacen falta dentro de la imagen
Dockerfile
.dockerignore
docker-compose.yml
.github

