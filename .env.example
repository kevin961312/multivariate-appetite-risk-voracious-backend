# Variables de entorno de Voracious (prefijo VORACIOUS_).
# Plantilla SIN secretos: cópiala a .env (que no se versiona) y ajusta los valores.
# La aplicación no lee .env por sí misma; cárgalo en el entorno (shell, Docker, orquestador).

# Nivel mínimo de logs: DEBUG | INFO | WARNING | ERROR
VORACIOUS_LOG_LEVEL=INFO

# Hilos de la extensión C de pymrcd (Qn/OGK) por ajuste MRCD; entero >= 1. Solo rendimiento: no
# cambia ningún resultado. Vacío = pymrcd decide (PYMRCD_NUM_THREADS o todos los CPU visibles).
VORACIOUS_MRCD_THREADS=

# Adaptadores: cola inline; repositorios memory | postgres (docker-compose.yml fija postgres).
VORACIOUS_JOB_BACKEND=inline
VORACIOUS_REPOSITORY=memory
# Almacenamiento de datasets: memory | local (.npy en disco con huella).
VORACIOUS_STORAGE=memory
# Directorio base de VORACIOUS_STORAGE=local (obligatorio con local).
VORACIOUS_STORAGE_DIR=

# Procesos para repartir las réplicas bootstrap; vacío = en serie. Solo rendimiento.
# Procesos x VORACIOUS_MRCD_THREADS no debería superar los núcleos (se avisa al arrancar).
VORACIOUS_REPLICATE_PROCESSES=

# Hilos de cada carril de la cola de trabajos (enteros >= 1).
VORACIOUS_QUEUE_WORKERS_ESTIMATION=1
VORACIOUS_QUEUE_WORKERS_CALIBRATION=1
VORACIOUS_QUEUE_WORKERS_LIGHT=4
VORACIOUS_QUEUE_WORKERS_ORCHESTRATION=2

# Tamaño máximo del cuerpo de una subida de dataset (POST /v1/datasets) en MiB; por encima, 413.
VORACIOUS_MAX_UPLOAD_MB=50

# --- Postgres (Paso 4.2; VORACIOUS_REPOSITORY=postgres) --------------------------------------------
# Cadena de conexión (SECRETO: nunca se registra en logs). Formato, sin credenciales reales aquí:
#   postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE
# Con docker-compose.yml: HOST = postgres y USUARIO/BASE/CONTRASEÑA = los POSTGRES_* de abajo
# (la contraseña con codificación URL si tiene caracteres como @ : / ? # %).
# Con postgres exige VORACIOUS_STORAGE=local (las matrices de los datasets siguen en disco).
VORACIOUS_DATABASE_URL=
# Conexiones máximas del pool (entero >= 1; por defecto 10). Solo rendimiento.
VORACIOUS_DATABASE_POOL_SIZE=

# Servicios postgres y backup de docker-compose.yml (interpolación de compose). POSTGRES_PASSWORD es
# obligatoria (sin ella compose no arranca); usuario y base valen «voracious» si se dejan vacíos.
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# --- Perfil 2 vCPU / 3.7 GiB (servidor de validación y demo; docker-compose.yml) -------------------
# Solo orientativo: descomenta y sustituye las líneas de arriba. No cambia ningún resultado (todo es
# rendimiento); evita sobresuscribir: procesos x hilos MRCD <= núcleos.
# VORACIOUS_REPLICATE_PROCESSES=2
# VORACIOUS_MRCD_THREADS=1
# VORACIOUS_QUEUE_WORKERS_ESTIMATION=1
# VORACIOUS_QUEUE_WORKERS_CALIBRATION=1
# VORACIOUS_QUEUE_WORKERS_LIGHT=2
# VORACIOUS_QUEUE_WORKERS_ORCHESTRATION=1
