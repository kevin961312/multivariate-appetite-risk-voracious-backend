# Variables de entorno de Voracious (prefijo VORACIOUS_).
# Plantilla SIN secretos: cópiala a .env (que no se versiona) y ajusta los valores.
# La aplicación no lee .env por sí misma; cárgalo en el entorno (shell, Docker, orquestador).

# Nivel mínimo de logs: DEBUG | INFO | WARNING | ERROR
VORACIOUS_LOG_LEVEL=INFO

# Hilos de la extensión C de pymrcd (Qn/OGK) por ajuste MRCD; entero >= 1. Solo rendimiento: no
# cambia ningún resultado. Vacío = pymrcd decide (PYMRCD_NUM_THREADS o todos los CPU visibles).
VORACIOUS_MRCD_THREADS=

# Adaptadores: cola inline; repositorios memory | postgres (docker-compose.yml fija postgres).
VORACIOUS_JOB_BACKEND=inline
VORACIOUS_REPOSITORY=memory
# Almacenamiento de datasets: memory | local (.npy en disco con huella).
VORACIOUS_STORAGE=memory
# Directorio base de VORACIOUS_STORAGE=local (obligatorio con local).
VORACIOUS_STORAGE_DIR=

# Procesos para repartir las réplicas bootstrap; vacío = en serie. Solo rendimiento.
# Procesos x VORACIOUS_MRCD_THREADS no debería superar los núcleos (se avisa al arrancar).
VORACIOUS_REPLICATE_PROCESSES=

# Hilos de cada carril de la cola de trabajos (enteros >= 1).
VORACIOUS_QUEUE_WORKERS_ESTIMATION=1
VORACIOUS_QUEUE_WORKERS_CALIBRATION=1
VORACIOUS_QUEUE_WORKERS_LIGHT=4
VORACIOUS_QUEUE_WORKERS_ORCHESTRATION=2

# Tamaño máximo del cuerpo de una subida de dataset (POST /v1/datasets) en MiB; por encima, 413.
VORACIOUS_MAX_UPLOAD_MB=50

# --- Postgres (Paso 4.2; VORACIOUS_REPOSITORY=postgres) --------------------------------------------
# Dos formas EXCLUYENTES de dar la cadena de conexión (SECRETO: nunca se registra en logs):
#   VORACIOUS_DATABASE_URL       directa en el entorno: SOLO desarrollo, CI y tests.
#   VORACIOUS_DATABASE_URL_FILE  ruta a un fichero con la URL (Compose: /run/secrets/database_url,
#                                lo fija docker-compose.yml; el fichero lo descifra scripts/deploy.sh).
# Formato, sin credenciales reales aquí: postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE
# (la contraseña con codificación URL si tiene caracteres como @ : / ? # %).
# Con postgres exige VORACIOUS_STORAGE=local (las matrices de los datasets siguen en disco).
# En el .env del servidor NO va ningún secreto: deploy.sh se niega a desplegar si trae
# POSTGRES_PASSWORD, VORACIOUS_DATABASE_URL, PGPASSWORD o algo *PRIVATE* con valor.
VORACIOUS_DATABASE_URL=
VORACIOUS_DATABASE_URL_FILE=
# Conexiones máximas del pool (entero >= 1; por defecto 10). Solo rendimiento.
VORACIOUS_DATABASE_POOL_SIZE=

# Servicios postgres y backup de docker-compose.yml (interpolación de compose). Usuario y base
# valen «voracious» si se dejan vacíos. La contraseña ya no va aquí: es el secreto de Compose
# postgres_password (DEPLOY_SECRETS_DIR/postgres_password, cifrado en deploy/demo/secrets.enc.yaml).
POSTGRES_USER=
POSTGRES_DB=

# --- Autenticación (seguridad mínima, ADR 0012) -------------------------------------------------
# La API no arranca sin estas tres (falla cerrado). En Compose vienen de deploy/demo/auth.env.
# JWKS con las llaves PÚBLICAS (cada una con kid y alg); nunca la privada.
VORACIOUS_JWT_JWKS_FILE=
# Emisor (iss) y audiencia (aud) exigidos en cada token, comparados enteros.
VORACIOUS_JWT_ISSUER=
VORACIOUS_JWT_AUDIENCE=
# Algoritmos admitidos, separados por comas: EdDSA (por defecto) | ES256 | RS256 | PS256.
VORACIOUS_JWT_ALGORITHMS=
# Margen de reloj en segundos para exp, nbf e iat (0 a 300; por defecto 30).
VORACIOUS_JWT_LEEWAY_SECONDS=

# --- Exposición por el proxy (paso E) ----------------------------------------------------------
# IP o redes CIDR de los proxies de confianza, separadas por comas: solo de ellos se creen
# X-Forwarded-For y X-Forwarded-Proto. Vacío = no se cree a nadie (la IP es la de la conexión).
# No admite *, /0 ni nombres de host. En Compose: la IP fija de Caddy (DEPLOY_PROXY_IP).
VORACIOUS_TRUSTED_PROXIES=
# Límite de peticiones por IP de cliente (cubo de fichas; por encima, 429 RATE_LIMITED con
# Retry-After). Por defecto 600 por minuto con ráfaga de 120. Operativo, no estadístico.
VORACIOUS_RATE_LIMIT_PER_MINUTE=
VORACIOUS_RATE_LIMIT_BURST=
# Orígenes de navegador admitidos por CORS, separados por comas: exactamente esquema://host[:puerto]
# (sin barra final ni comodines parciales; http solo en localhost, 127.0.0.1 y [::1]), o * SOLO
# para admitir cualquier origen (seguro: el token va en Authorization, nunca en cookies).
# Vacío = CORS cerrado. En Compose vienen de deploy/demo/api.env.
VORACIOUS_CORS_ALLOWED_ORIGINS=
# Documentación interactiva (/docs, /redoc, /openapi.json): true (por defecto) | false.
VORACIOUS_API_DOCS=
# Trabajos de cómputo en cola o en curso por tenant (entero >= 1; por defecto 4); por encima,
# 429 TOO_MANY_JOBS. Operativo, no estadístico.
VORACIOUS_MAX_ACTIVE_JOBS_PER_TENANT=

# --- Despliegue (scripts/deploy.sh y docker-compose.yml; no son de la aplicación) ---------------
# Directorio de los secretos descifrados (0700, FUERA del repo; ficheros 0444). Compose no arranca
# sin él. Por defecto en deploy.sh: ${XDG_STATE_HOME:-$HOME/.local/state}/voracious/demo/secrets.
# Ponerlo aquí (no es un secreto, es una ruta) permite usar «docker compose ps/logs» a mano.
DEPLOY_SECRETS_DIR=
# Configuración versionada de la demo (jwks.json, auth.env, api.env, proxy.env y los cifrados);
# por defecto deploy/demo.
DEPLOY_DIR=
# Subred de la red edge (proxy y api) y la IP fija del proxy dentro de ella; la API confía en esa
# IP (VORACIOUS_TRUSTED_PROXIES). Cámbialas solo si chocan con otra red del servidor.
# Por defecto 172.29.80.0/24 y 172.29.80.10.
DEPLOY_EDGE_SUBNET=
DEPLOY_PROXY_IP=

# --- Perfil 2 vCPU / 3.7 GiB (servidor de validación y demo; docker-compose.yml) -------------------
# Solo orientativo: descomenta y sustituye las líneas de arriba. No cambia ningún resultado (todo es
# rendimiento); evita sobresuscribir: procesos x hilos MRCD <= núcleos.
# VORACIOUS_REPLICATE_PROCESSES=2
# VORACIOUS_MRCD_THREADS=1
# VORACIOUS_QUEUE_WORKERS_ESTIMATION=1
# VORACIOUS_QUEUE_WORKERS_CALIBRATION=1
# VORACIOUS_QUEUE_WORKERS_LIGHT=2
# VORACIOUS_QUEUE_WORKERS_ORCHESTRATION=1
