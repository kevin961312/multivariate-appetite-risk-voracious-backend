# Configuración PÚBLICA del borde de la demo (paso E). No es secreta y se versiona en claro. Que exista
# activa el modo público de scripts/deploy.sh (perfil public de Compose: Caddy en el 443); sin este
# fichero el despliegue es privado y el 443 queda cerrado.
#   PROXY_PUBLIC_HOST  nombre con certificado; permanente (los integradores lo fijan en su código)
#   PROXY_TLS_MODE     acme (Let's Encrypt, la demo) | internal (CA propia: solo CI y pruebas)
PROXY_PUBLIC_HOST=api.voracious.cloud
PROXY_TLS_MODE=acme
